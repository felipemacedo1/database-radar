<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.databaseradar</groupId>
  <artifactId>database-radar-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Database Radar</name>
  <description>Evidence-first static analysis for Java-to-database impact discovery</description>
  <url>https://github.com/felipemacedo1/database-radar</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>graph-core</module>
    <module>sql-analyzer</module>
    <module>persistence-analyzer</module>
    <module>java-analyzer</module>
    <module>report</module>
    <module>cli</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <jackson.version>2.19.2</jackson.version>
    <javaparser.version>3.28.2</javaparser.version>
    <jsqlparser.version>5.3</jsqlparser.version>
    <junit.version>5.13.4</junit.version>
    <picocli.version>4.7.7</picocli.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.databaseradar</groupId>
        <artifactId>graph-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.databaseradar</groupId>
        <artifactId>sql-analyzer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.databaseradar</groupId>
        <artifactId>persistence-analyzer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.databaseradar</groupId>
        <artifactId>java-analyzer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.databaseradar</groupId>
        <artifactId>report</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.javaparser</groupId>
        <artifactId>javaparser-symbol-solver-core</artifactId>
        <version>${javaparser.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.jsqlparser</groupId>
        <artifactId>jsqlparser</artifactId>
        <version>${jsqlparser.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
